{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcservices",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
