{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rc-it-consulting-services",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "rcitcs.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.rcitcs.com/*",
      "zone_name": "rcitcs.com"
    }
  ],
  "secrets": {
    "required": ["SUPABASE_SECRET_KEY"]
  },
  "vars": {
    "SUPABASE_URL": "https://chsizmffzpxcqhaptjeu.supabase.co",
    "PUBLIC_CAREERS_API_URL": "https://chsizmffzpxcqhaptjeu.supabase.co/functions/v1/public-careers",
    "ADMIN_PROXY_BASE": "/admin",
    "ADMIN_PROXY_WILDCARD": "/admin/*"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
